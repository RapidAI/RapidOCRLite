# Cross toolchain for loongarch64 Linux (GCC >= 13), e.g. Debian/Ubuntu
# g++-loongarch64-linux-gnu. Tests run under qemu-loongarch64 user mode.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR loongarch64)
set(PPOCR_LOONGARCH_TRIPLE loongarch64-linux-gnu CACHE STRING "")
set(CMAKE_C_COMPILER ${PPOCR_LOONGARCH_TRIPLE}-gcc)
set(CMAKE_CXX_COMPILER ${PPOCR_LOONGARCH_TRIPLE}-g++)
if(NOT DEFINED CMAKE_SYSROOT AND EXISTS /usr/${PPOCR_LOONGARCH_TRIPLE})
  set(CMAKE_FIND_ROOT_PATH /usr/${PPOCR_LOONGARCH_TRIPLE})
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
if(NOT CMAKE_CROSSCOMPILING_EMULATOR)
  set(CMAKE_CROSSCOMPILING_EMULATOR qemu-loongarch64 -L /usr/${PPOCR_LOONGARCH_TRIPLE})
endif()
